<!DOCTYPE html>
<html>
<head>
<meta charset="utf-8">
<title>數位平台監控系統 - 初始設定</title>
<HTA:APPLICATION ID="app" APPLICATIONNAME="數位平台監控系統安裝" BORDER="thin" CAPTION="yes" SCROLL="no" SINGLEINSTANCE="yes" WINDOWSTATE="normal" />
<style>
body{margin:0;background:#0d1a2e;color:#eef6ff;font-family:"Microsoft JhengHei",sans-serif}.box{width:650px;margin:0 auto;padding:28px 34px}.head{text-align:center;margin-bottom:22px}.head h1{margin:8px 0;font-size:26px}.head p{color:#9fb2c8;margin:0}.step{display:flex;align-items:center;gap:14px;margin:11px 0;padding:14px 16px;background:#12243b;border:1px solid #2f4965;border-radius:12px}.n{width:30px;height:30px;border-radius:50%;background:#193552;display:flex;align-items:center;justify-content:center;color:#66d9ff;font-weight:bold}.txt{flex:1}.state{font-weight:bold;color:#93a8bf}.ok{color:#52d69b}.bad{color:#ff7585}.run{color:#65d9ff}.buttons{text-align:center;margin-top:22px}button{margin:6px;padding:11px 18px;border:0;border-radius:9px;font-family:inherit;font-weight:bold;cursor:pointer}#install{background:#0794d2;color:white}#sync,#retry{background:#334a68;color:white;display:none}#launch{background:#20a96b;color:white;display:none}.msg{margin-top:18px;padding:13px;border-radius:10px;background:#091523;color:#b8c9db;line-height:1.6;font-size:13px}.small{font-size:11px;color:#71859b;text-align:center;margin-top:16px}
</style>
<script language="VBScript">
Option Explicit
Dim fso, sh, rootPath, htaPath, iconPath
Set fso=CreateObject("Scripting.FileSystemObject")
Set sh=CreateObject("WScript.Shell")

Sub Window_OnLoad
  window.resizeTo 740,650
  On Error Resume Next
  window.moveTo (screen.availWidth-740)/2,(screen.availHeight-650)/2
  On Error GoTo 0
End Sub

Sub SetState(id,text,cls)
  document.getElementById(id).innerText=text
  document.getElementById(id).className="state " & cls
End Sub

Sub StartInstall
  document.getElementById("install").disabled=True
  SetState "s1","檢查中…","run"
  If FindPlatformRoot() Then
    SetState "s1","完成","ok"
    SetState "s2","完成","ok"
    CheckMainProgram
  Else
    SetState "s1","完成","ok"
    SetState "s2","尚未同步","bad"
    document.getElementById("sync").style.display="inline-block"
    document.getElementById("retry").style.display="inline-block"
    document.getElementById("message").innerText="尚未找到「數位工作平台 - 文件」。請先完成公司 SharePoint / OneDrive 同步，完成後按「重新檢查」。"
    document.getElementById("install").disabled=False
  End If
End Sub

Function FindPlatformRoot()
  Dim userProfile,candidate,folder,subf
  FindPlatformRoot=False
  rootPath=""
  userProfile=sh.ExpandEnvironmentStrings("%USERPROFILE%")
  candidate=userProfile & "\OneDrive - FarEasTone Telecommunications Co., Ltd\數位工作平台 - 文件"
  If fso.FolderExists(candidate) Then rootPath=candidate: FindPlatformRoot=True: Exit Function
  On Error Resume Next
  Set folder=fso.GetFolder(userProfile)
  If Err.Number=0 Then
    For Each subf In folder.SubFolders
      If InStr(1,subf.Name,"OneDrive - ",1)=1 Then
        candidate=subf.Path & "\數位工作平台 - 文件"
        If fso.FolderExists(candidate) Then rootPath=candidate: FindPlatformRoot=True: Exit Function
      End If
    Next
  End If
  On Error GoTo 0
End Function

Sub CheckMainProgram
  SetState "s3","檢查中…","run"
  htaPath=rootPath & "\平台入口\數位平台監控系統.hta"
  iconPath=rootPath & "\平台入口\數位平台監控系統.ico"
  If Not fso.FileExists(htaPath) Then
    SetState "s3","找不到主程式","bad"
    document.getElementById("message").innerText="已找到同步資料夾，但找不到：平台入口\數位平台監控系統.hta"
    document.getElementById("retry").style.display="inline-block"
    document.getElementById("install").disabled=False
    Exit Sub
  End If
  If Not fso.FileExists(iconPath) Then
    SetState "s3","找不到圖示","bad"
    document.getElementById("message").innerText="已找到主程式，但找不到：平台入口\數位平台監控系統.ico"
    document.getElementById("retry").style.display="inline-block"
    document.getElementById("install").disabled=False
    Exit Sub
  End If
  SetState "s3","完成","ok"
  CreateShortcut
End Sub

Sub CreateShortcut
  Dim desktop,link,shortcutPath
  SetState "s4","建立中…","run"
  desktop=sh.SpecialFolders("Desktop")
  shortcutPath=desktop & "\數位平台監控系統.lnk"
  Set link=sh.CreateShortcut(shortcutPath)
  link.TargetPath=sh.ExpandEnvironmentStrings("%SystemRoot%\System32\mshta.exe")
  link.Arguments=Chr(34) & htaPath & Chr(34)
  link.WorkingDirectory=fso.GetParentFolderName(htaPath)
  link.IconLocation=iconPath & ",0"
  link.Description="數位平台監控系統"
  link.Save
  If fso.FileExists(shortcutPath) Then
    SetState "s4","完成","ok"
    SetState "s5","完成","ok"
    document.getElementById("launch").style.display="inline-block"
    document.getElementById("message").innerText="初始設定完成。桌面已建立「數位平台監控系統」捷徑。"
  Else
    SetState "s4","建立失敗","bad"
    document.getElementById("message").innerText="無法建立桌面捷徑。"
  End If
  document.getElementById("install").disabled=False
End Sub

Sub OpenSync
  sh.Run "https://fetonline.sharepoint.com/sites/AutomationCenter/Shared%20Documents/Forms/AllItems.aspx",1,False
End Sub
Sub RetryCheck
  document.getElementById("sync").style.display="none"
  document.getElementById("retry").style.display="none"
  StartInstall
End Sub
Sub LaunchApp
  sh.Run Chr(34) & sh.ExpandEnvironmentStrings("%SystemRoot%\System32\mshta.exe") & Chr(34) & " " & Chr(34) & htaPath & Chr(34),1,False
End Sub
</script>
</head>
<body>
<div class="box"><div class="head"><div style="font-size:42px">⚙</div><h1>數位平台監控系統</h1><p>正在進行初始設定</p></div>
<div class="step"><div class="n">1</div><div class="txt">檢查 OneDrive 與平台同步資料夾</div><div id="s1" class="state">等待中</div></div>
<div class="step"><div class="n">2</div><div class="txt">檢查「數位工作平台 - 文件」同步</div><div id="s2" class="state">等待中</div></div>
<div class="step"><div class="n">3</div><div class="txt">檢查平台主程式與圖示</div><div id="s3" class="state">等待中</div></div>
<div class="step"><div class="n">4</div><div class="txt">建立桌面捷徑與平台圖示</div><div id="s4" class="state">等待中</div></div>
<div class="step"><div class="n">5</div><div class="txt">完成平台設定</div><div id="s5" class="state">等待中</div></div>
<div class="buttons"><button id="install" language="VBScript" onclick="StartInstall">開始設定</button><button id="sync" language="VBScript" onclick="OpenSync">設定 OneDrive 同步</button><button id="retry" language="VBScript" onclick="RetryCheck">重新檢查</button><button id="launch" language="VBScript" onclick="LaunchApp">開始使用</button></div>
<div id="message" class="msg">按「開始設定」後，系統會尋找公司 OneDrive 中的「數位工作平台 - 文件」，確認主程式與圖示後建立桌面捷徑。</div><div class="small">V6 測試版｜沿用第一版可執行的 VBScript 按鈕方式｜只修正主程式與圖示位置</div></div>
</body></html>
